# RASA SYSTEM (رسا سیستم) — backend environment (copy to .env)
# Never commit real secrets to git (blueprint §82).

APP_NAME=RASA SYSTEM
ENVIRONMENT=development

# SQLite (default, offline-first). For a central server use e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/supermarket
DATABASE_URL=sqlite:///./data/supermarket.db

# Security — CHANGE THIS in production.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-boot admin (change after first login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS origins (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# External resolver API timeout (seconds).
EXTERNAL_TIMEOUT_SECONDS=8

# Vendor support relay (v1.7) — OPTIONAL. Never commit a real token.
# Preferred: set it once per installation in the app (Settings → پشتیبانی) or
# with scripts/provision_relay.py, which stores it in system_settings.
SUPPORT_RELAY_URL=https://botapi.rubika.ir/v3
SUPPORT_RELAY_TOKEN=
SUPPORT_INBOX_ID=
