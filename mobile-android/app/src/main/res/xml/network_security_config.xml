<?xml version="1.0" encoding="utf-8"?>
<!-- The PC currently serves its shop-LAN API over HTTP. Network Security Config must
     permit that transport; Api.requireSafeEndpoint enforces the private-LAN-only rule
     before an Authorization header is sent. Public internet endpoints require HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
