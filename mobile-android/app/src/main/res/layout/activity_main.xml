<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0f1420">

    <TextView android:id="@+id/offline_banner" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/offline_banner" android:textColor="#111827" android:background="#f59e0b"
        android:gravity="center" android:padding="6dp" android:visibility="gone" android:textSize="13sp" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
        <WebView android:id="@+id/webview" android:layout_width="match_parent" android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
